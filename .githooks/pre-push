#!/usr/bin/env bash
# Refuses a push that would publish something private (see CLAUDE.md). Enable it once
# per clone; setup-user.sh does this for the clone it runs from:
#   git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha _ _; do
  [[ "$local_sha" == "$zero" ]] && continue   # deleting a ref publishes nothing
  node scripts/check-public.mjs --ref "$local_ref" "$local_sha" --not --remotes="$1"
done
node scripts/check-public.mjs
